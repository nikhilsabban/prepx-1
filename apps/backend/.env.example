PORT=3003
MONGO_URI=mongodb://localhost:27017/prepx
JWT_SECRET=your_jwt_secret_key_here

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2
GROQ_MAX_CONCURRENT_EVALUATIONS=2

# Group Discussion (GD) Topic Discovery Configuration
GD_TOPIC_SOURCE_MODE=rss
GD_TOPIC_RSS_FEEDS=https://feeds.bbci.co.uk/news/technology/rss.xml,https://feeds.bbci.co.uk/news/world/rss.xml,https://www.technologyreview.com/feed/,https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml,https://www.wired.com/feed/rss,https://timesofindia.indiatimes.com/rssfeeds/66949542.cms
GD_TOPIC_REFRESH_MINUTES=30
GD_TOPIC_MAX_AGE_DAYS=7
GD_TOPIC_FETCH_TIMEOUT_MS=8000
GD_TOPIC_MAX_ITEMS_PER_FEED=50
GD_TOPIC_CACHE_TTL_MINUTES=30
GD_MAX_PARTICIPANTS=5

# Voice and Audio
DEEPGRAM_API_KEY=your_deepgram_api_key_here
PROXY_URL=

# Email and Cloud Services
SMTP_EMAIL=
SMTP_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
